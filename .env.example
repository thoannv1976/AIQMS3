# ===== AIQMS3 environment template =====
# Copy to .env and fill in values.

# Database (Cloud SQL PostgreSQL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aiqms?schema=public"

# Auth (JWT signing secret) — use `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_SESSION_DAYS="7"

# AI provider (Anthropic Claude). Empty => safe deterministic fallback (no external calls).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# File storage. driver = local | gcs
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
GCS_BUCKET=""
GCS_PROJECT_ID=""

# App
NODE_ENV="development"
APP_NAME="AIQMS3"
